# Worker env — copy via: deploy/scripts/init-dev-env.sh → deploy/dev/worker.env
# Load order:
#   set -a && source deploy/dev/.env && set +a
#   set -a && source deploy/dev/worker.env && set +a
# Workers must NOT receive MARKHAND_AUTH_*.

MARKHAND_WORKER_ORG_ID=11111111-1111-1111-1111-111111111111
MARKHAND_WORKER_USER_ID=22222222-2222-2222-2222-222222222201

# Prefer the dedicated markhand_worker role when provisioned:
# MARKHAND_WORKER_DATABASE_URL=postgres://markhand_worker:markhand_worker_dev_only@127.0.0.1:54329/markhand
# Local/dev compatibility only — never set in qualifying POC/prod evidence:
MARKHAND_WORKER_ALLOW_APP_DB_FALLBACK=1

# AITeamVN CPU (must match deploy/dev/.env)
MARKHAND_EMBEDDING_BASE_URL=http://127.0.0.1:8088/v1
MARKHAND_EMBEDDING_API_KEY=dev-embedding-key
MARKHAND_EMBEDDING_PROVIDER=openai-compatible
MARKHAND_EMBEDDING_MODEL=AITeamVN/Vietnamese_Embedding
MARKHAND_EMBEDDING_REVISION=dea33aa1ab339f38d66ae0a40e6c40e0a9249568
MARKHAND_EMBEDDING_DIMENSIONS=1024
MARKHAND_EMBEDDING_RUNTIME_PATH=local-neural
MARKHAND_INDEX_SIGNATURE=ca03085c08f4c01d391ac973192815c944892f6e74b52e7bf4e1f135f65ae97c

# --- OpenRouter cloud embedding (ADR 0016) — thay block AITeamVN ở trên ---
# Đổi model/dimension/runtime_path tạo index signature MỚI → phải reindex
# (ADR 0006/0011). Bật cờ egress tường minh vì index build gửi toàn bộ chunk text.
# MARKHAND_EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
# MARKHAND_EMBEDDING_API_KEY=<openrouter-key>
# MARKHAND_EMBEDDING_PROVIDER=openrouter
# MARKHAND_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
# MARKHAND_EMBEDDING_REVISION=qwen3-embedding-8b-20251028
# MARKHAND_EMBEDDING_DIMENSIONS=1024
# MARKHAND_EMBEDDING_RUNTIME_PATH=provider-cloud
# MARKHAND_ALLOW_CLOUD_EMBEDDINGS=true
# MARKHAND_EMBEDDING_NORMALIZE=client
# MARKHAND_EMBEDDING_SEND_DIMENSIONS=true
# MARKHAND_INDEX_SIGNATURE=<chạy deploy/scripts/print-index-signature.py với config trên>

# Vision OCR stage (worker, ngoài sandbox — bắt buộc để convert ảnh/PDF scan):
# MARKHAND_OCR_API_KEY=<openrouter-key>
# MARKHAND_OCR_BASE_URL=https://openrouter.ai/api   # mặc định OpenRouter
# MARKHAND_OCR_MODEL=qwen/qwen3.7-flash             # mặc định
# Batching theo bench 2026-08-10 (10 trang≈60–150s/16K token; 5≈30–70s/12K;
# 1 trang chạy bù≈20–50s/8K). Timeout/request = min(cap, 60s + 15s×trang);
# batch lỗi parse/truncation/transient tự bisect xuống 1 trang.
# MARKHAND_OCR_BATCH_PAGES=5          # 1..16; trang thưa chữ có thể để 10
# MARKHAND_OCR_TIMEOUT_SECS=300       # cap cho MỘT request batch

# Optional: disable Landlock sandbox on Linux dev (Windows always direct subprocess)
# MARKHAND_CONVERTER_DISABLE_SANDBOX=1
# MARKHAND_WORKER_KIND=convert
# MARKHAND_WORKER_ID=dev-convert-1
# MARKHAND_CONVERTER_ARGV_JSON='["./target/debug/fileconv.exe","one","{input}","--ocr-defer-dir","."]'
# Windows: dùng fileconv.exe; Linux: ./target/debug/fileconv hoặc release

# MARKHAND_WORKER_KIND=index
# MARKHAND_WORKER_ID=dev-index-1

# MARKHAND_WORKER_KIND=embedding
# MARKHAND_WORKER_ID=dev-embedding-1

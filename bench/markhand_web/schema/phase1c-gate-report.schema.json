{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "reportId",
    "generatedAt",
    "status",
    "git",
    "environmentId",
    "workloadProfileId",
    "targetMatch",
    "command",
    "denialManifestSha256",
    "metrics",
    "thresholdDecisions",
    "workerProof",
    "gateResults",
    "redactionScan",
    "vulnerabilityScan",
    "canonicalBinding"
  ],
  "properties": {
    "version": {"const": 1},
    "reportId": {"type": "string", "minLength": 1},
    "generatedAt": {"type": "string", "format": "date-time"},
    "status": {"enum": ["pass", "fail", "incomplete", "not_run"]},
    "command": {"const": "python3 bench/markhand_web/scripts/run_phase1c_gate.py"},
    "environmentId": {"const": "phase1c-multi-org-poc"},
    "workloadProfileId": {"const": "phase1c-multi-org"},
    "targetMatch": {"type": "boolean"},
    "denialManifestSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "dirty"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "dirty": {"type": "boolean"}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cross_tenant_leakage_count",
        "post_commit_stale_authorizations",
        "membership_acl_revoke_max_ms",
        "quota_drift_after_recovery",
        "quiet_org_query_p95_ms",
        "starvation_events",
        "admin_mutation_audit_coverage_ratio",
        "worker_dedicated_role_verified",
        "undispositioned_high_critical_count"
      ],
      "properties": {
        "cross_tenant_leakage_count": {"type": "integer", "minimum": 0},
        "post_commit_stale_authorizations": {"type": "integer", "minimum": 0},
        "membership_acl_revoke_max_ms": {"type": "number", "minimum": 0},
        "quota_drift_after_recovery": {"type": "integer", "minimum": 0},
        "quiet_org_query_p95_ms": {"type": "number", "minimum": 0},
        "starvation_events": {"type": "integer", "minimum": 0},
        "admin_mutation_audit_coverage_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "worker_dedicated_role_verified": {"type": "integer", "enum": [0, 1]},
        "undispositioned_high_critical_count": {"type": "integer", "minimum": 0}
      }
    },
    "thresholdDecisions": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric",
          "operator",
          "value",
          "unit",
          "statistic",
          "source",
          "provenance",
          "provenanceKind",
          "owner",
          "approver",
          "recordedAt"
        ],
        "properties": {
          "metric": {"type": "string", "minLength": 1},
          "operator": {"enum": [">=", ">", "<=", "<", "=="]},
          "value": {"type": "number"},
          "unit": {"enum": ["count", "milliseconds", "ratio"]},
          "statistic": {"enum": ["min", "max"]},
          "source": {"const": "docs/markhand-web-sla-targets.md"},
          "provenance": {"const": "docs/superpowers/plans/2026-07-31-phase1c-closure.md"},
          "provenanceKind": {"const": "repository-design-decision"},
          "owner": {"type": "string", "minLength": 1},
          "approver": {"type": "string", "minLength": 1},
          "recordedAt": {"type": "string", "format": "date-time"}
        }
      }
    },
    "workerProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtimeRole",
        "dedicatedDatabaseUrlVerified",
        "superuser",
        "bypassRls",
        "verifiedAt"
      ],
      "properties": {
        "runtimeRole": {"const": "markhand_worker"},
        "dedicatedDatabaseUrlVerified": {"type": "boolean"},
        "superuser": {"type": "boolean"},
        "bypassRls": {"type": "boolean"},
        "verifiedAt": {"type": "string", "format": "date-time"}
      }
    },
    "gateResults": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gateId",
          "externalGate",
          "metric",
          "value",
          "pass",
          "failureDisposition",
          "evidence"
        ],
        "properties": {
          "gateId": {"type": "string", "pattern": "^G1C-SEC-[A-Z0-9-]+$"},
          "externalGate": {"const": "G1C-SEC"},
          "metric": {"type": "string", "minLength": 1},
          "value": {"type": "number"},
          "pass": {"type": "boolean"},
          "failureDisposition": {"const": "block-phase-1c"},
          "evidence": {"type": "string", "minLength": 1},
          "coverageLimited": {"type": "boolean"},
          "metricsObserved": {"type": "boolean"}
        }
      }
    },
    "redactionScan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed"],
      "properties": {
        "passed": {"type": "boolean"}
      }
    },
    "vulnerabilityScan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scanner", "undispositionedHighCritical", "findings", "passed"],
      "properties": {
        "scanner": {"type": "string", "minLength": 1},
        "undispositionedHighCritical": {"type": "integer", "minimum": 0},
        "findings": {"type": "array"},
        "passed": {"type": "boolean"}
      }
    },
    "canonicalBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registryRevision",
        "environmentSha256",
        "workloadSha256",
        "gatesSha256",
        "slaSha256",
        "thresholdDecisionsSha256"
      ],
      "properties": {
        "registryRevision": {"const": 1},
        "environmentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "workloadSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "gatesSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "slaSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "thresholdDecisionsSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "coverageLimited": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "pass"}},
        "required": ["status"]
      },
      "then": {
        "required": ["coverageLimited"],
        "properties": {
          "coverageLimited": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    }
  ]
}
